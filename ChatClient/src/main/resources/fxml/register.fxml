<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.chatapp.client.controller.RegisterController"
            prefHeight="600.0" prefWidth="400.0"
            style="-fx-background-color: #2C3E50;">

    <VBox alignment="CENTER" spacing="15" AnchorPane.topAnchor="30" AnchorPane.leftAnchor="50"
          AnchorPane.rightAnchor="50" AnchorPane.bottomAnchor="30">

        <!-- Title -->
        <Label text="Create Account" textFill="white" style="-fx-font-size: 28px; -fx-font-weight: bold;">
            <font>
                <Font name="System Bold" size="28.0"/>
            </font>
        </Label>

        <Label text="Sign up to get started" textFill="#BDC3C7" style="-fx-font-size: 14px;">
            <font>
                <Font size="14.0"/>
            </font>
        </Label>

        <!-- Spacing -->
        <Region prefHeight="10"/>

        <!-- Full Name Field -->
        <VBox spacing="5">
            <Label text="Full Name" textFill="white"/>
            <TextField fx:id="fullNameField" promptText="Enter your full name"
                       style="-fx-background-color: #34495E; -fx-text-fill: white; -fx-prompt-text-fill: #7F8C8D;"
                       prefHeight="35"/>
        </VBox>

        <!-- Username Field -->
        <VBox spacing="5">
            <Label text="Username" textFill="white"/>
            <TextField fx:id="usernameField" promptText="Choose a username"
                       style="-fx-background-color: #34495E; -fx-text-fill: white; -fx-prompt-text-fill: #7F8C8D;"
                       prefHeight="35"/>
        </VBox>

        <!-- Email Field -->
        <VBox spacing="5">
            <Label text="Email" textFill="white"/>
            <TextField fx:id="emailField" promptText="Enter your email"
                       style="-fx-background-color: #34495E; -fx-text-fill: white; -fx-prompt-text-fill: #7F8C8D;"
                       prefHeight="35"/>
        </VBox>

        <!-- Password Field -->
        <VBox spacing="5">
            <Label text="Password" textFill="white"/>
            <PasswordField fx:id="passwordField" promptText="Choose a password (min 6 characters)"
                           style="-fx-background-color: #34495E; -fx-text-fill: white; -fx-prompt-text-fill: #7F8C8D;"
                           prefHeight="35"/>
        </VBox>

        <!-- Confirm Password Field -->
        <VBox spacing="5">
            <Label text="Confirm Password" textFill="white"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm your password"
                           style="-fx-background-color: #34495E; -fx-text-fill: white; -fx-prompt-text-fill: #7F8C8D;"
                           prefHeight="35"/>
        </VBox>

        <!-- Error Label -->
        <Label fx:id="errorLabel" textFill="#E74C3C" wrapText="true" visible="false"/>

        <!-- Register Button -->
        <Button fx:id="registerButton" text="Register" onAction="#handleRegister"
                style="-fx-background-color: #27AE60; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"
                prefWidth="300" prefHeight="40">
            <cursor>
                <javafx.scene.Cursor fx:constant="HAND"/>
            </cursor>
        </Button>

        <!-- Login Link -->
        <HBox alignment="CENTER" spacing="5">
            <Label text="Already have an account?" textFill="#BDC3C7"/>
            <Hyperlink text="Login" textFill="#3498DB" onAction="#handleLoginLink"
                       style="-fx-font-weight: bold;"/>
        </HBox>

    </VBox>

</AnchorPane>
